# ---------------------------------------------------------------------------
# Zedu Store - environment template.  Copy this file to `.env.local`, then fill in.
# Never commit `.env.local`; this example file is the only env file in git.
# ---------------------------------------------------------------------------

# === Supabase (https://supabase.com/dashboard -> Project Settings -> API) ===
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon public" key - safe in the browser (protected by row level security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" secret key - SERVER ONLY. Never prefix this with NEXT_PUBLIC_.
# It is what lets the checkout route write orders and read them back.
SUPABASE_SERVICE_ROLE_KEY=

# === Resend (https://resend.com/api-keys) - the email provider =============
# Create a key at https://resend.com/api-keys, then paste it here. This is the
# only value the confirmation email needs.
RESEND_API_KEY=
# From header. The shared testing sender works with no domain setup, but it can
# ONLY deliver to the address that owns the Resend account. Verify a domain to
# send anywhere. https://resend.com/docs/knowledge-base/403-error-resend-dev-domain
RESEND_FROM="Zedu Store <onboarding@resend.dev>"
# Optional reply-to
RESEND_REPLY_TO=

# === Email provider selection =============================================
# resend (what this project uses) | mailgun
EMAIL_PROVIDER=resend
# Set to 1 to try the other configured provider when the first one fails.
EMAIL_FALLBACK=1

# === Mailgun (https://app.mailgun.com -> Settings -> API keys / Domains) ====
# OPTIONAL, unused while EMAIL_PROVIDER=resend. Kept so the transport can be
# switched back on without a code change.
# Private API key
MAILGUN_API_KEY=
# Sending domain, e.g. sandbox1234abcd.mailgun.org or your own domain
MAILGUN_DOMAIN=
# EU-hosted accounts use https://api.eu.mailgun.net
MAILGUN_API_BASE=https://api.mailgun.net
# From header. Must be on MAILGUN_DOMAIN. Sandbox needs an authorized recipient.
MAILGUN_FROM="Zedu Store <postmaster@YOUR_MAILGUN_DOMAIN>"
# Optional reply-to
MAILGUN_REPLY_TO=

# === Google OAuth ==========================================================
# These are entered in the Supabase dashboard (Authentication -> Providers ->
# Google), NOT read by this app. Listed here so the whole setup lives in one
# place:
#   GOOGLE_CLIENT_ID=...apps.googleusercontent.com
#   GOOGLE_CLIENT_SECRET=...
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web):
#   Authorised JavaScript origin:  http://localhost:3000
#   Authorised redirect URI:       https://<project-ref>.supabase.co/auth/v1/callback
