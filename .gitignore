# generated by `next build`; safe to commit but noisy in diffs
# next-env.d.ts

# Internal AI session handoff notes; kept locally, not part of the published project
HANDOFF*.md

# Output of tools/install-mobile.ps1 — local npm diagnostic logs. The script's
# copy lands in tools/, the convenience copy in apps/mobile/, and the ad-hoc
# invocations produced install-log2..5.txt; none of them belong in the repo.
**/install-log*.txt

# Scratch space: the redirected npm cache, unpacked archives, temp downloads.
# It reached 144 MB / 2592 files and was once committed by `git add -A` — never
# again at that size.
.tmp/

# Expo / React Native app (apps/mobile) — its own .gitignore also applies.
apps/mobile/node_modules/
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/.env
apps/mobile/.env.local
