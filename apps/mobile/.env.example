# Copy to `.env` and fill in. Everything here is PUBLIC — it is bundled into the
# app and anyone with the APK can read it. Only ever put the *anon* key here.
#
# NEVER add the Supabase service role key: it bypasses row level security and
# would let anyone rewrite every cart and order in the project.

# The deployed shop API. Point this at http://<your-lan-ip>:3000 to test against
# `npm run dev` on your computer instead of production.
EXPO_PUBLIC_API_BASE_URL=https://adorable-raindrop-ea8591.netlify.app

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://mhikydmbjbajrkzbxdnz.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
